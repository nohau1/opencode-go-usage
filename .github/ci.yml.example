# GitHub Actions workflow, kept outside .github/workflows so it can be pushed
# with a Personal Access Token that has no `workflow` scope.
#
# To enable CI, either:
#   1. add the `workflow` scope to your token and move this file to
#      .github/workflows/ci.yml, or
#   2. create .github/workflows/ci.yml through the GitHub web UI and paste the
#      contents below.
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  typecheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run typecheck
